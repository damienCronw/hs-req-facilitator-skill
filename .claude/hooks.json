{
  "version": "1.0",
  "hooks": {
    "SessionStart": {
      "enabled": true,
      "description": "会话启动时初始化环境",
      "matchers": {
        "always": true
      },
      "commands": [
        {
          "name": "init-env",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && git status --short > /tmp/git-status.txt"
          ],
          "async": true
        },
        {
          "name": "load-env",
          "shell": "bash",
          "args": [
            "-c",
            "echo 'export PATH=\"$HOME/.npm-global/bin:$PATH\"' > /tmp/claude-env.sh && source /tmp/claude-env.sh"
          ],
          "async": true
        }
      ]
    },
    "PreToolUse": {
      "enabled": true,
      "description": "工具调用前检查AskUserQuestion格式",
      "matchers": {
        "toolNames": ["Bash", "Write", "Edit"]
      },
      "commands": [
        {
          "name": "validate-askuserquestion",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && bash scripts/pre-commit-check.sh --quick"
          ],
          "onError": "continue"
        }
      ]
    },
    "PostToolUse": {
      "enabled": true,
      "description": "工具执行后检查是否需要部署",
      "matchers": {
        "toolNames": ["Bash"],
        "patterns": ["deploy", "commit", "git.*push"]
      },
      "commands": [
        {
          "name": "auto-deploy",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && if [ -f .deploy-on-change ] || git diff --quiet && git diff --cached --quiet; then echo 'No changes to deploy'; else echo 'Changes detected, auto-deploying...' && bash scripts/auto-deploy.sh --auto; fi"
          ],
          "async": true,
          "onError": "continue"
        },
        {
          "name": "update-status",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && git status --short > /tmp/git-status-after.txt"
          ],
          "async": true
        }
      ]
    },
    "Notification": {
      "enabled": true,
      "description": "发送部署通知",
      "matchers": {
        "eventTypes": ["deployment", "error", "success"]
      },
      "commands": [
        {
          "name": "log-notification",
          "shell": "bash",
          "args": [
            "-c",
            "echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Notification: $CLAUDE_NOTIFICATION_TYPE - $CLAUDE_NOTIFICATION_MESSAGE\" >> /Volumes/MacHD/hs-skills/hs-req-facilitator-skill/logs/hooks.log"
          ],
          "async": true
        }
      ]
    },
    "SessionEnd": {
      "enabled": true,
      "description": "会话结束时清理和总结",
      "matchers": {
        "always": true
      },
      "commands": [
        {
          "name": "cleanup",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && echo 'Session Summary:' >> /tmp/session-summary.txt && echo 'Git Status: ' >> /tmp/session-summary.txt && git status --short >> /tmp/session-summary.txt 2>&1"
          ],
          "async": false
        },
        {
          "name": "archive-logs",
          "shell": "bash",
          "args": [
            "-c",
            "cd /Volumes/MacHD/hs-skills/hs-req-facilitator-skill && mkdir -p logs/archive && mv logs/*.log logs/archive/$(date +%Y%m%d-%H%M%S).log 2>/dev/null || true"
          ],
          "async": true
        }
      ]
    }
  },
  "security": {
    "allowedDirectories": [
      "/Volumes/MacHD/hs-skills/hs-req-facilitator-skill",
      "~/.claude/skills/hs-req-facilitator-skill"
    ],
    "blockedCommands": [
      "rm -rf /",
      "sudo",
      "format"
    ],
    "requireApproval": [
      "git push --force",
      "rm -rf *"
    ]
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "file": "/Volumes/MacHD/hs-skills/hs-req-facilitator-skill/logs/hooks.log"
  }
}
